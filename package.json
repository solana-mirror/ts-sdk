{
  "name": "solana-mirror",
  "version": "1.0.0",
  "description": "Retrieve current and historical data for your Solana wallet",
  "main": "build/index.js",
  "scripts": {
    "build": "rm -rf build/ && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write .",
    "precommit": "tsc && lint-staged",
    "prepublishOnly": "npm run build",
    "ci": "npm i && npm run build && npm run test"
  },
  "keywords": [],
  "author": "config_json",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
